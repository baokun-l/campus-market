<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ======================== Maven 配置 ======================== -->
    <!-- 父工程：Spring Boot 3.2.5，统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.campus</groupId>
    <artifactId>campus-secondhand-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>campus-secondhand-backend</name>
    <description>校园二手集市后端 - 前后端分离架构</description>

    <properties>
        <java.version>17</java.version>
        <!--
            ★★ 可复现构建（reproducible build）★★
            把产物里所有"随时间变化"的元数据（jar 条目时间戳等）钉死成一个固定值，
            使 **jar 的字节内容成为源码 + 依赖的纯函数**：
              同一份源码 → 两次构建 → 完全相同的 sha256。
            为什么本项目需要它：
              没有这一项时，实测「同一份源码、连续构建两次」产出的 jar **sha256 不同**，
              于是 sha256 只能证明"传输没损坏"，无法回答"这两个包是不是同一份代码" ——
              而后者恰恰是出事后的第一个问题。
            ★ 固定成常量而不是"用构建时间"：用构建时间等于没钉，
              每次构建都不一样，可复现性就无从谈起。
            ★ 它只影响元数据，不影响字节码；真正的字节码一致性还要靠
              deploy/build-release.mjs 里对 JDK 的钉死（见那里的注释）。
        -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <jwt.version>0.12.5</jwt.version>
        <spring-ai.version>1.0.0-M6</spring-ai.version>
        <!--
            springdoc 版本与 Spring Boot 版本是**配对关系**，不能随手升：
            2.x 是给 Spring Boot 3 用的（1.x 只支持 Boot 2），
            其中 2.3.0 对应 Boot 3.2.x —— 与本项目父工程版本一致。
            升 Boot 大版本时必须同步核对 springdoc 的支持矩阵。
        -->
        <springdoc.version>2.3.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- Web 服务器：内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring MVC 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 数据访问层：MyBatis-Plus（内置 MyBatis + 分页插件） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 连接池：HikariCP（Spring Boot 默认） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!--
            本地缓存：Caffeine（部署适配清单 P1-11）

            ★ 为什么只引 Caffeine，不引 spring-boot-starter-cache ★
            需要缓存的只有「鉴权快照」这一处（AuthInterceptor 每请求回查 t_user）。
            starter-cache 会带来 @EnableCaching + AOP 代理 + 一整套 CacheManager 自动配置，
            而本项目的失效点是**显式**的（谁改了 status/role/token_version 谁负责清），
            不需要注解式的切面语义 —— 少一层魔法，就少一处「改完没生效且不报错」的角落
            （本项目已多次栽在这类静默失效上）。

            版本由 spring-boot-starter-parent 统一管理，不写 version。
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- JWT 认证 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
            密码哈希：只取 BCrypt 算法本体（spring-security-crypto），
            不引入 spring-boot-starter-security —— 那会自带一整套 Filter 链，
            把现有 JWT 拦截器的路由规则全部接管，改动面太大。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ======================== Spring AI ======================== -->
        <!-- Spring AI 集成：用于智能客服 / 商品描述生成 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- ======================== 接口文档（OpenAPI 3 / Swagger UI） ======================== -->
        <!--
            ★ 为什么是 springdoc 而不是 springfox ★
            springfox 3.0 早在 Spring Boot 2.6 之后就与 Spring MVC 的路径匹配策略冲突
            （默认策略从 AntPathMatcher 换成 PathPatternParser），Boot 3 上直接不可用。
            springdoc 是社区接续维护的那一支，且自带 Swagger UI 静态资源，无需再配 webjar。
            ★ 运行时依赖 ★ 它会扫描所有 @RestController 生成 /v3/api-docs，
            生产环境用 springdoc.api-docs.enabled / swagger-ui.enabled 关掉即可（见 application.yml）。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        ================== Spring AI 里程碑仓库（部署清单 P0-7）==================
        ★ 为什么留在这里 ★
        spring-ai 目前是 1.0.0-M6（里程碑版），而**里程碑版不在 Maven Central**，
        只存在于 repo.spring.io。所以这个仓库声明是构建能跑通的前提，
        删掉它就会直接构建失败（不是"降级"，是 ERROR）。

        ★ 升级到 GA 的事，为什么没做 ★
        Spring AI 1.0.0 GA（及之后）确实能只从 Central 拉、不再需要本仓库，
        但官方升级说明写明：**GA 只支持 Spring Boot 3.4.x / 3.5.x**，
        而本项目父工程是 3.2.5。也就是说「升 spring-ai」实际会拖出一次
        Spring Boot 大版本迁移（连带 MyBatis-Plus、springdoc 都要跟着升，
        371 个单测与全部真机探针要重新回归）—— 那是**独立的一批依赖升级**，
        不该塞进「部署适配」里顺手做掉。

        ★ 那 P0-7 的风险（"服务器构建可能拉不到 repo.spring.io"）怎么消掉 ★
        采用部署清单给出的**推荐方案 1：服务器不构建，只收 jar 产物**。
        理由：这个风险的本质是"目标机器能不能连上境外 Maven 仓库"，
        而它和业务代码毫无关系；把"能不能构建"变成上线的前置条件，
        是最不必要的一类故障源。构建统一在本机/CI 完成，
        服务器只执行 java -jar（见 deploy/build-release.sh）。
        ⇒ 因此构建产物**必须**用 `-Pprod` 打（见下面 profiles 段）。
    -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        ============ 生产打包 profile（部署清单 P0-2 的第 2 层）============
        用法：./mvnw -Pprod clean package -DskipTests

        ★ 为什么要"把 demo 资源排除出 jar"，而不是只靠启动参数挡住 ★
        P0-2 原本就写明要"三层至少做前两层"：
          第 1 层（已做）：部署脚本把 profile 写死成 prod，不允许外部传；
          第 2 层（本段）：打包时**物理剔除** demo 相关资源；
          第 3 层（已做）：DeploymentGuard 在连库之前拒绝带 demo 的启动。
        只做第 1、3 层时，"demo 会毁数据"这件事靠的是**运行时判断**；
        而运行时的东西总有绕过的可能（比如有人手敲 java -jar 忘了写 profile、
        或临时用某个环境变量覆盖）。第 2 层是**编译期**的：资源根本不在包里，
        想跑也没有脚本可跑。对"参数写错就毁掉全部真实商品与订单"这种后果，
        值得多一道物理防线。

        ★ 被排除的东西与后果 ★
          application-demo.yml  → demo profile 没有数据源配置，起不来；
          db/demo-*.sql         → 清空/重灌商品、分类、订单、审核日志的脚本不在了。
        本地做课堂演示时**不用** -Pprod（普通 `mvn package` 仍然带上这些文件）。

        ★ 为什么用 <resources> 覆盖而不是加 exclude 到别处 ★
        这里显式重列了 `src/main/resources` 并只加排除项，
        等价于默认资源集减去 demo 文件 —— 不会漏掉别的资源（mapper/*.xml 等）。
    -->
    <profiles>
        <profile>
            <id>prod</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>application-demo.yml</exclude>
                            <exclude>db/demo-*.sql</exclude>
                        </excludes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
