# ====================================================================
# 生产环境变量模板
# ====================================================================
# 用法：复制为 /etc/campus-market/env，填上真值，权限 600、属主 campus
#   sudo install -o campus -g campus -m 600 env.example /etc/campus-market/env
#
# ★ 这个文件里**不能**出现真实口令 ★ 它要进仓库。
# ★ 不要 export 到 shell（会进 .bash_history），也不要写进 ExecStart（ps 可见）。
#
# 全部变量都是「prod 必填 / 可选」两类，必填项缺一个 DeploymentGuard 就会让进程起不来，
# 而且会把缺的是哪个、该怎么生成直接打在日志里 —— 这是刻意的：起不来比悄悄起在错的配置上好。
# ====================================================================

# ---------- 必填：数据库 ----------
# 注意三处与开发环境不同：
#   · 不要 createDatabaseIfNotExist=true（需要 CREATE 权限，生产账号只该有 CRUD）
#   · 不要 useSSL=false（会把库口令、用户手机号明文过网）
#   · serverTimezone 要与实际一致；真正的会话时区由 APP_TIME_ZONE_OFFSET 统一管
DB_URL=jdbc:mysql://127.0.0.1:3306/campus_market?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED
DB_USERNAME=campus_app
DB_PASSWORD=CHANGE_ME

# ---------- 必填：JWT ----------
# 生成：openssl rand -base64 48
# 至少 32 字节（HS256 硬要求）；用仓库里那个兜底值会被护栏直接拒启动
JWT_SECRET=CHANGE_ME

# ---------- 选填：有安全默认值 ----------
# 跨域白名单。前后端同域反代（前端用 VITE_API_BASE=/api 相对路径）时**留空即可**：
# 留空 = 不放行任何跨域来源。前端若改放独立域名/CDN，必须填 https://your-domain.com，
# 否则跨域请求会被一律拒绝，而排查方向很容易被误导成 Nginx 或 token 问题。
CORS_ALLOWED_ORIGINS=

# 用户上传目录。必须移出源码树（源码树会被下次部署覆盖掉）
UPLOAD_DIR=/data/campus/uploads

# 日志落盘目录。同样必须移出源码树 —— 否则「覆盖式部署」会把历史日志一起删掉，
# 而排查线上问题时最需要的恰恰是出事之前的那些日志。
# 滚动策略（按天 + 100MB 切分 + 保留 30 天 + 总量 2GB 上限 + ERROR 单独一份）
# 写在 src/main/resources/logback-spring.xml 里，不在这里。
LOG_DIR=/data/campus/logs

# 多实例部署时**每个实例必须不同**（0..9）。订单号末段含实例号，
# 两个实例配同一个值就会撞号；越界会直接抛错（不静默夹紧）
APP_INSTANCE_ID=0

# ★ 时区：JVM 默认时区与 MySQL 会话时区共用这一个开关 ★
# 两侧不一致会让「在线」功能整体静默失效（无报错，只是绿点不亮）或永久在线。
# 用 +08:00 这种固定偏移，不要写 Asia/Shanghai（MySQL 无时区表时会报 unknown time zone）
APP_TIME_ZONE_OFFSET=+08:00

# ---------- AI 助手闸门（长度上限 + 调用频次）----------
# ★ 为什么生产必须显式看一眼这一段 ★
# AI 接口要登录才能调，但「要登录」不等于安全：任何一个注册账号写个 for 循环
# 就能把接口打上万次，**每一次都是真实支出**。全站维度是唯一能兜住账单的那条网，
# 上线前请按「可接受的月账单」反推一个 global-max-calls，而不是直接沿用默认 300。
#   默认：单用户 10 分钟 30 次 / 全站 10 分钟 300 次
# ★ 0 或负数 = 该维度不限 ★（沿用本仓「缺配置一律放宽」的口径）。
#   window-seconds 例外：配 0 会被收敛到 1 秒（0 毫秒窗口=计数器每次归零=闸门静默失效）。
# ★ 长度上限的默认值是对齐出来的，不是随手取的 ★
#   max-title-length 200 = t_goods.title VARCHAR(200)；max-message-length 200 = 前端输入框 maxlength。
#   调小它们会让「界面能打出来的量」被后端拒掉，属于把可用性修坏。
AI_GUARD_USER_MAX_CALLS=30
AI_GUARD_GLOBAL_MAX_CALLS=300
AI_GUARD_WINDOW_SECONDS=600
AI_GUARD_MAX_TITLE_LENGTH=200
AI_GUARD_MAX_KEYWORDS_LENGTH=200
AI_GUARD_MAX_MESSAGE_LENGTH=200

# 接口文档。prod 下会被 DeploymentGuard **强制关闭**，这两个变量写了也没用 ——
# 留在这里是提醒：不要把开发环境的环境文件整份复制上生产。
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# 启动期是否执行 SQL 脚本。默认 never（结构变更不该是启动的副作用）。
# 仅首次建库时临时设成 always，建完改回 never。
# SQL_INIT_MODE=always

# 连接池 / 线程（2 核 4G 单实例的参考值；多实例要按 MySQL max_connections 摊）
# DB_POOL_MAX=10
# DB_POOL_MIN_IDLE=5
# TOMCAT_MAX_THREADS=50

# 只有 MySQL 没开 TLS 且与应用同机时才需要放宽（回环地址不过网，可接受）
# DB_SSL_MODE=PREFERRED

# ====================================================================
# 支付渠道
# ====================================================================
# ★★★ 变量名必须带 APP_ 前缀 —— 这不是风格问题，是"能不能生效"的问题 ★★★
#
#   app.pay.* 在 yml 里**没有任何占位符**，只靠 Spring Boot 的 relaxed binding
#   从环境变量绑定，规则是「点、横线都换成下划线，加 APP_ 前缀」：
#       app.pay.public-base-url   ←→   APP_PAY_PUBLIC_BASE_URL
#
#   少写 APP_（例如写成 PAY_PUBLIC_BASE_URL）**不会报任何错，只是绑不上**：
#   值保持空 ⇒ notify_url 拼不出来 ⇒ 该渠道 available() 为 false
#   ⇒ **从收银台静默消失**，日志里一条错都没有。
#
#   已做真机对照（三类命名 × GET /pay/channels，见 .workbuddy/e2e-pay-env.mjs）：
#     全 APP_PAY_*                        → ["alipay_sandbox","wallet"]  渠道在
#     全 PAY_*                            → ["demo","wallet"]            渠道没了
#     只有回调地址这一项漏写 APP_          → ["wallet"]                    同样没了
#   第三行就是"照着旧文档配"的下场，所以这一段里的每个名字都请照抄。

# 允许使用的渠道（逗号分隔）。prod 下 demo 会被**无条件**拒绝
# （它等于「不付钱就把订单推进到待发货」，是资损级后门，不信任配置）。
APP_PAY_ENABLED_CHANNELS=wallet

# ★★ 必须是**渠道服务器能访问到的公网地址**，且是 https 域名 ★★
# 填 http://localhost:8080 等于让支付宝去它自己机器上打 8080 —— 回调永远进不来，
# 而本地日志里**什么都不会有**（请求压根没到我们这儿），
# 排查时最容易误判成"验签失败"或"回调逻辑没写对"。
APP_PAY_PUBLIC_BASE_URL=https://your-domain.com

# 异步通知路径（拼在 public-base-url 之后，渠道名由代码追加）。
# 保持默认即可；Nginx 上 /api/pay/notify/** **不得**加 limit_req（见部署清单 §7.5）
# APP_PAY_NOTIFY_PATH=/api/pay/notify

# 支付完成后浏览器跳回的前端地址。留空则用户停在支付宝的结果页
# APP_PAY_RETURN_URL=https://your-domain.com/orders

# 订单支付时限（分钟），默认 1440（24 小时）。
# ★ 它同时落进 pay_expire_at 并作为 timeout_express 传给支付宝 ★
# 不传的话支付宝默认给 15 天 ⇒ 出现「我们已关单、用户第 3 天还能付款」的错位。
# APP_PAY_ORDER_TIMEOUT_MINUTES=1440

# ---- 支付宝沙箱：四项齐全才会出现在收银台 ----
# 获取步骤：open.alipay.com → 控制台 → 沙箱环境（个人实名即可，**无需营业执照**）；
# 用「密钥工具」生成 RSA2 密钥对，把**应用公钥**填进沙箱应用的「接口加签方式」，
# 然后复制平台给出的**支付宝公钥**。沙箱买家的账号/密码在沙箱首页「账号信息」里。
#
# ★ 私钥泄露 = 任何人可以冒充本商户发起退款 ★ 所以仓库里绝不能有真值，
#   这份模板进仓库，真值只放在 /etc/campus-market/env（权限 600、属主 campus）。
# APP_PAY_ALIPAY_APP_ID=
# ★ 应用私钥，支持带 PEM 头尾，也支持用 \n 表示换行 ★
# APP_PAY_ALIPAY_PRIVATE_KEY=
# ★ 这是**支付宝公钥**（用来验签回调），与上面的应用私钥不是一对 ★
# APP_PAY_ALIPAY_PUBLIC_KEY=
# 网关地址默认已是沙箱；生产环境要改成 https://openapi.alipay.com/gateway.do
# APP_PAY_ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 配好后自查：登录后调 GET /api/pay/channels，
#   alipay_sandbox **出现在列表里** 才算配置生效（不出现就是上面某个名字写错了）。
# 四项缺任何一项时渠道会沉默地消失 —— 这是刻意的：
# 宁可不显示该渠道，也不出现「能付款、但订单永远停在待付款」这种最糟的半可用状态。


# ---- 健康检查（P1-5）：GET /api/health（匿名可读）----
# 数据库探测的限时（毫秒），默认 2000，下限 200。
# ★ 为什么必须限时 ★：数据库挂掉时 getConnection() 会等连接池的 connectionTimeout
#   （Hikari 默认 30 秒）。健康检查若同步等，探针就会挂 30 秒 ⇒ 监控判超时 ⇒
#   「探针看不出故障」变成「探针自己不可用」。
# HEALTH_DB_TIMEOUT_MS=2000

# ★★ 监控口径：看响应体，不要只看 HTTP 状态码 ★★
# 本项目所有业务错误一律 HTTP 200 + body 业务码（为适配前端 axios 的错误分支而定的约定，
# 不要改），所以数据库挂了 /api/health 也返回 HTTP 200。就绪判据：
#   curl -fsS http://127.0.0.1:8080/api/health | jq -e '.data.status == "UP"'
# 云监控只支持关键字匹配时，匹配 "status":"UP"。
#   UP       = 数据库可查 + 日志目录可写
#   DEGRADED = 数据库好，但**日志目录不可写**（服务能用，但故障现场正在丢失）
#   DOWN     = 数据库不可用
#
# ★ 日志目录可写性为什么被纳入健康检查 ★
# systemd 单元里的 ProtectSystem=strict 会把根文件系统挂成只读，
# 只有 ReadWritePaths 列出的路径可写 —— 那里必须同时包含 LOG_DIR 指到的目录，
# 否则 logback 写不进文件，而它**只在启动时打一行错误**，之后完全静默。
# 新建目录后属主要是 campus:campus。
LOG_DIR=/data/campus/logs
