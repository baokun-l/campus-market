# ---- 开发环境 ----
# axios 的 baseURL：相对前缀，走 Vite 代理转发到后端
VITE_API_BASE=/api

# Vite dev server 的代理目标：必须是**后端服务的源**（协议+主机+端口），
# 不能填 /api —— 详见 vite.config.ts 里的注释。
# 后端：server.port=8080，context-path=/api
VITE_API_PROXY=http://localhost:8080

# 联调总开关：
#   true  → 走 src/api/mock.ts 内置假数据，**完全不请求后端**（纯前端演示用）
#   false → 走真实后端（当前值）。切换前请确认：
#           ① 后端已启动（mvn spring-boot:run 或 java -jar target/*.jar）
#           ② MySQL 已导入 schema.sql（需要演示数据再执行 db/demo-data.sql）
#           ③ VITE_API_PROXY 指向的端口与后端一致
#   ⚠️ 本工作区当前配置为「联调模式」，前端所有请求真实打到 8080 后端。
#      若要回到离线演示，把下面这行改回 true 并重启 dev server。
VITE_USE_MOCK=false

VITE_APP_TITLE=校园二手集市
