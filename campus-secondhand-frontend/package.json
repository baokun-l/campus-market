{
  "name": "campus-secondhand-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "校园二手交易系统前端 · Vue3 + Element Plus + ECharts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:no-check": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,scss}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:vue": "node scripts/check-vue.mjs",
    "check:ts": "node scripts/check-ts.mjs",
    "check": "npm run check:vue && npm run check:ts",
    "analyze": "vite build --config vite.analyze.config.ts",
    "compare:size": "node scripts/compare-build-size.mjs",
    "scan:icons": "node scripts/scan-icons.mjs",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "element-plus": "^2.7.6",
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.5.0",
    "vue-echarts": "^7.0.3",
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "nprogress": "^0.2.0",
    "mitt": "^3.0.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "@vue/test-utils": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/nprogress": "^0.2.3",
    "@types/lodash-es": "^4.17.12",
    "typescript": "~5.4.5",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.19",
    "unplugin-vue-components": "^0.27.0",
    "unplugin-auto-import": "^0.17.5",
    "sass": "^1.77.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "vitest": "^1.6.0",
    "happy-dom": "^14.7.1",
    "@vitest/coverage-v8": "^1.6.0"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
