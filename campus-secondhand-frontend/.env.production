# ---- 生产构建环境 ----
# 生产产物部署为静态文件，浏览器请求 /api/xxx 由**同域反向代理**（Nginx 等）
# 转发到后端，因此 baseURL 保持相对前缀即可。
VITE_API_BASE=/api

# 仅影响 `vite dev` 的本地代理，对 `vite build` 产物无效。
VITE_API_PROXY=http://localhost:8080

# 生产构建走真实后端（当前值）——本项目是「前后端分离」交付，
# 构建产物必须请求后端，否则线上仍是纯前端 Mock 单机版。
# 部署时需在 Nginx 里把 /api 反代到后端服务（server.port=8080，context-path=/api）。
# 若要产出**离线可跑的纯前端演示包**，把下面这行改回 true 再 build。
VITE_USE_MOCK=false

VITE_APP_TITLE=校园二手集市

# ---- 产物部署路径（部署适配清单 P2-3）----
#   VITE_BASE=/         → 站点挂在根域名（默认；与不写这行**完全等价**）
#   VITE_BASE=/market/  → 挂在子路径 https://host/market/
# 改这一处即可：前端资源前缀与路由的 history base 都取自 Vite 注入的 BASE_URL。
# ★ 但 Nginx 那边仍要把 `/api/**`（接口）与 `/uploads/**`（图片）反代到后端 ★
#   这两个是**绝对路径**（数据库里存的就是 `/uploads/2026/09/xxx.jpg`），不随 base 变化。
VITE_BASE=/
