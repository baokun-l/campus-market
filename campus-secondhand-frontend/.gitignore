# Auto-generated type files
src/types/auto-imports.d.ts
src/types/components.d.ts

# Vite / Vitest 临时配置产物（每次构建重新生成，不应入库）
*.timestamp-*.mjs

# `npm run test:audit` 产出的口径报告（每次运行重新生成，用于核对文件数）
.vitest-report.json
