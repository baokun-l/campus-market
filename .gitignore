# ===================================================================
# 仓库根 .gitignore（2026-09-23 · D-GIT 销项）
# -------------------------------------------------------------------
# 两个子模块各有自己的 .gitignore（backend: target/dist/uploads/logs/IDE；
# frontend: node_modules/dist/coverage/IDE），这里只管根级与 .workbuddy。
# ★ .workbuddy 分两类：
#   · 进库 —— *.mjs（审计/探针/同步脚本，是这套工程纪律的载体）、
#             memory/（项目长期记忆与逐轮日志）、mvn-aliyun-settings.xml、selfcheck/
#   · 不进 —— bak-*/（同步前备份副本）、tmp/、各种 *.log / 临时 *.txt /
#             bak-full-*.sql（含演示库口令哈希的 dump）
# ===================================================================

# ---------- .workbuddy：备份 / 临时 / 日志 ----------
.workbuddy/bak-*/
.workbuddy/tmp/
# 红绿探针的「留底」：只在被 SIGTERM 打断时留着，供下一次运行自愈，跑完即删。
# 属运行产物而非脚本，不进库 —— 但它必须存在，否则探针被硬杀后突变会留在源码里。
.workbuddy/.redgreen-backup/
# 逐轮真机证据摘录（*.txt，与 *.log 同类）：结论已写进「项目缺陷检查与修复清单.md」，这里只是过程留档
.workbuddy/evidence/
.workbuddy/bak-full-*.sql
.workbuddy/**/*.log
.workbuddy/*.log
.workbuddy/*.txt

# ---------- 防御性兜底（子模块已忽略，这里防「从根直接构建」的落点） ----------
node_modules/
target/
dist/
uploads/
logs/
*.log

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 提交物（作业交付物：源码 zip + 报告 pdf）----------
# 属于「交付产物」而不是源码：体积是二进制级（数 MB），且每次交作业都会整体重建，
# 进库只会让每次 diff 都变成一大坨二进制。报告正文与其配图的可编辑源保存在
# .workbuddy/tmp/report-task3/（临时目录，不进库），生成管线见 skill
# `submission-pack-and-report`。
提交物/

# ---------- 敏感配置兜底 ----------
.env
.env.local
